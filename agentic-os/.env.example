# Agentic OS update source
# The updater reads these settings only from the root .env file.
# Leave either value empty to use the defaults shown here.
AGENTIC_OS_UPSTREAM_SLUG=simonc602/agentic-os
AGENTIC_OS_UPSTREAM_BRANCH=main

# API keys for Agentic OS skills
# This file is auto-created as .env by the installer — just fill in your keys below
# All keys are optional — skills work without them and tell you when one would help

# Firecrawl — web scraping, branding extraction (https://www.firecrawl.dev/app)
# Used by: firecrawl-scraper skill, mkt-brand-voice Auto-Scrape mode
# Free tier: 500 credits/month
FIRECRAWL_API_KEY=

# OpenAI — Reddit search via Responses API (https://platform.openai.com/api-keys)
# Used by: str-trending-research (Reddit threads with real engagement metrics),
#          viz-image-gen (image generation via GPT Image)
# Pay-as-you-go pricing
OPENAI_API_KEY=

# xAI — X/Twitter search via xAI API (https://console.x.ai)
# Used by: str-trending-research (X posts with real likes, reposts, replies)
# Pay-as-you-go pricing
XAI_API_KEY=

# YouTube Data API v3 — channel listing,
# @handle resolution, video search
# Get a free key at https://console.cloud.google.com/ (10,000 units/day free tier)
# Used by: tool-youtube
YOUTUBE_API_KEY=

# Google Gemini — image generation via Gemini 3 Pro Image (https://ai.google.dev/)
# Used by: viz-image-gen (image generation, infographics, visual content)
GEMINI_API_KEY=

# HeyGen — AI avatar video generation (https://app.heygen.com/avatar?nav=API)
# Used by: viz-ugc-heygen (UGC video creation with cloned avatars)
# Credits-based pricing on your HeyGen plan
HEYGEN_API_KEY=

# Google Workspace CLI (gws) — OAuth credentials for Drive, Gmail, Calendar, etc.
# Create a Desktop OAuth client at https://console.cloud.google.com/apis/credentials
# Used by: gws CLI (Google Workspace operations)
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=

# Telegram — bot token for Claude Code Channels plugin
# Create a bot via @BotFather on Telegram to get a token
# Used by: scripts/telegram.sh (Telegram channel launcher)
TELEGRAM_BOT_TOKEN=

# Telegram — comma-separated Telegram user IDs allowed to chat
# Get your ID from @userinfobot on Telegram
# Leave empty to allow all users (not recommended)
TELEGRAM_ALLOWED_USERS=

# Hosted team memory — Postgres + pgvector (Railway or VPS)
# Connection string for the hosted memory store. When set, ALL memory commands
# (memory:migrate / memory:index / memory:search / memory:recall) run against
# hosted Postgres instead of local PGLite — same schema either way. Falls back to
# DATABASE_URL, which Railway injects automatically. Never commit a real value.
# MEMORY_DATABASE_URL=postgres://user:password@host:5432/agentic_memory
# Optional SSL override: disable | require | no-verify
# (default: SSL on for remote hosts, off for localhost). Use `disable` for a
# Railway private/internal URL.
# PGSSLMODE=
# Optional: pin the storage engine. auto (default) = Postgres iff a connection
# string is set, else PGLite. `postgres` REQUIRES a URL (errors rather than
# silently using the local store); `pglite` forces local.
# MEMORY_STORE_BACKEND=auto   # auto | pglite | postgres
# Team OS memory routing. auto uses the hosted Team OS API when signed in,
# and local PGLite when signed out. local forces offline PGLite.
# TEAM_OS_MEMORY_MODE=auto   # auto | team | local

# Better Auth — app sign-in, sessions, organizations, API keys, and device auth
# Generate a strong secret with: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# Public app URL, for callbacks and generated links.
# BETTER_AUTH_URL=http://localhost:3000
# Hosted/team mode disables local-only Command Centre routes such as terminal
# execution, .env editing, script running, and broad filesystem reads.
# AGENTIC_OS_HOSTED_MODE=0

# Hosted memory API — ingest/search endpoints over the memory store
# Bearer token for the `npm run memory:api` server (POST /v1/memory/search and
# /v1/memory/ingest). REQUIRED to start the server — it never serves
# unauthenticated. Generate one with: openssl rand -hex 32
# MEMORY_API_TOKEN=
# Port for the API server. Falls back to PORT (Railway injects it), then 8787.
# MEMORY_API_PORT=8787
# Optional: let hosted /v1/memory/search generate the BGE-M3 query embedding
# server-side when callers send embeddingMode:"server". The normal CLI uses this
# automatically when /v1/health reports it is enabled. When set to 1, the API
# loads/downloads the model at startup and fails fast if the model is unavailable.
# MEMORY_API_SERVER_EMBEDDINGS=0
# Optional: BGE-M3 model cache. Defaults to AGENTIC_OS_DIR/.command-centre/models.
# MEMORY_MODEL_CACHE_DIR=
# In hosted mode, these are required so the server resolves identity itself
# instead of trusting teamId/userId from request JSON.
# MEMORY_API_TEAM_ID=
# MEMORY_API_USER_ID=

# Team OS server workspace GitHub backup
# Used by hosted Team OS deployments to back up files written under AGENTIC_OS_DIR.
# Mount AGENTIC_OS_DIR on persistent storage before enabling this.
# TEAM_OS_GITHUB_BACKUP_REMOTE=https://github.com/your-user/your-private-backup.git
# TEAM_OS_GITHUB_BACKUP_TOKEN=
# TEAM_OS_GITHUB_BACKUP_BRANCH=main
# TEAM_OS_GITHUB_BACKUP_USER_NAME=Team OS Backup
# TEAM_OS_GITHUB_BACKUP_USER_EMAIL=team-os-backup@example.invalid
# TEAM_OS_GITHUB_BACKUP_INTERVAL_SECONDS=900

# Hosted session capture scope. Local solo capture still defaults to system
# memory. Hosted capture defaults to private and requires team + user context.
# MEMORY_CAPTURE_TEAM_ID=
# MEMORY_CAPTURE_USER_ID=
# Optional: capture into a client when the user has write access.
# MEMORY_CAPTURE_CLIENT_ID=
# MEMORY_CAPTURE_VISIBILITY=private   # private | client | team | system
# Admin/service only: allow shared system capture.
# MEMORY_CAPTURE_ALLOW_SYSTEM=0
